{
  "compilerOptions": 
   {
    "rootDir": "../../..",
    "outDir": "./dist",
    "module": "CommonJS",
    "target": "ES2020",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
  },
  "include": [
    "src/**/*",
    "../../../shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}