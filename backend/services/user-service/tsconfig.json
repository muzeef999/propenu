{
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "./dist",
    "module": "CommonJS",
    "target": "ES2020",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "moduleResolution": "node",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "../../shared"],
  "exclude": ["node_modules", "dist"]
}