{
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "./dist",
    "module": "Node16",
    "target": "ES2020",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
     "strict": true, 
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node16"
  },
  "include": ["src/**/*", "../../shared"],
  "exclude": ["node_modules", "dist"]
}
